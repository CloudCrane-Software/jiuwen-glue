# config.env.example — gpumachine 执行面配置模板（WO-0009）
#
# 用法: cp config.example.env config.env，按真机情况修改后执行 01~05。
# 纪律（PROP-0001）:
#   - 执行面零长期密钥：本文件只允许出现非敏感配置与 OpenBao 引用路径，
#     任何密钥明文不得写入本文件或任何脚本。
#   - 本文件属 CNB 私有仓 company-ops；同步 GitHub 前必须去除拓扑细节。
#
# 目标机器基线（来自 内部硬件手册实测记录 + PROP-0001 §1）:
#   Tesla V100S-PCIE-32GB（sm_70，fp16 可用 / bf16 不可用）
#   8 核 / 62G 内存 / 99G 盘；系统将重装为 Anolis 23（Agentic Edition）

# ---------- 隧道地址（WireGuard 网段占位；开通后以实际隧道为准） ----------
# srv-1 在隧道上的地址（WO-0009 工单指定占位）
SRV1_TUNNEL_ADDR="${SRV1_TUNNEL_ADDR:-<srv-1-wg-addr>}"
# gpumachine 在隧道上的地址（占位，供文档与 Higress 上游规划引用）
GPU_TUNNEL_ADDR="${GPU_TUNNEL_ADDR:-<gpu-wg-addr>}"

# ---------- OpenBao（凭据代理，密钥唯一来源） ----------
# bao 运行于 srv-1（容器内 8200，未直接暴露 host；经隧道的暴露方式在 M1 定案，
# 占位写法沿用 srv-1 容器内地址，隧道打通后按实际可达性改写）
BAO_ADDR="${BAO_ADDR:-http://${SRV1_TUNNEL_ADDR}:8200}"
# 短期 worker token 文件（WO-0005 已建 worker policy：只读模型 key 与任务凭据，ttl<=1h）
BAO_TOKEN_FILE="${BAO_TOKEN_FILE:-/etc/gpumachine/bao-worker-token}"
# 模型消费 key（Higress consumer `glue-core` 的 key-auth 值）的 bao 路径
BAO_PATH_HIGRESS_KEY="${BAO_PATH_HIGRESS_KEY:-<vault-path>}"
# jiuwenswarm 团队库（srv-1 Postgres）账号的 bao 路径
BAO_PATH_PG_URL="${BAO_PATH_PG_URL:-<vault-path>}"

# ---------- srv-1 控制面服务地址（隧道侧） ----------
# 模型唯一强制入口（PROP-0001 §4.9 #7）：Higress gateway（srv-1 上 8080，仅内网）
HIGRESS_BASE="${HIGRESS_BASE:-http://${SRV1_TUNNEL_ADDR}:8080/v1}"
# 注意：srv-1 侧 Higress/pg 当前只绑回环（WO-0001 LISTEN_IP 机制），隧道暴露在 M1 WO-0003 收尾；
# 本占位与 RUNBOOK 前置条件对应，开通后若端口未放行，脚本健康检查会显式失败而不是静默降级。

# ---------- jiuwenswarm（03 脚本） ----------
JIUWENSWARM_PORT="${JIUWENSWARM_PORT:-18092}"          # AgentServer 默认 18092
JIUWENSWARM_MODEL_NAME="${JIUWENSWARM_MODEL_NAME:-step-3.5-flash}"  # Higress 路由内的模型名
JIUWENSWARM_VENV="${JIUWENSWARM_VENV:-/opt/gpumachine/jiuwenswarm/venv}"
# 关闭 openJiuwen 官网远端配置 = 关闭华为账号登录/免费模型通道出站（无华为通道出站）
JIUWENSWARM_CONFIG_URL="${JIUWENSWARM_CONFIG_URL:-off}"

# ---------- 本地模型（04 脚本） ----------
LOCAL_MODEL_MODE="${LOCAL_MODEL_MODE:-vllm}"           # vllm|ollama|llamacpp|agent-infer
VLLM_PINNED_VERSION="${VLLM_PINNED_VERSION:-0.9.2}"    # ADR-0001 候选（V0 引擎末期；未实测，开通后按 ADR 实测步骤校准）
LOCAL_MODEL_ID="${LOCAL_MODEL_ID:-Qwen/Qwen2.5-0.5B-Instruct}"  # 冒烟模型（ModelScope 源）
LOCAL_MODEL_PORT="${LOCAL_MODEL_PORT:-8000}"
LOCAL_MODEL_GPU_FRAC="${LOCAL_MODEL_GPU_FRAC:-0.30}"   # 共享显存纪律：冒烟只占小份

# ---------- 观测（05 脚本） ----------
OTEL_EXPORT_TARGET="${OTEL_EXPORT_TARGET:-<srv-1-wg-addr>:4317}"  # srv-1 Collector（部署随 WO-0006）
OTEL_EXPORT_PROTOCOL="${OTEL_EXPORT_PROTOCOL:-grpc}"
OTEL_EDGE_BUFFER_MB="${OTEL_EDGE_BUFFER_MB:-512}"          # 执行面边缘缓冲（§4.9 #6）
AGENTSIGHT_VERSION="${AGENTSIGHT_VERSION:-v0.13.0}"        # github.com/alibaba/anolisa 发布（WO-0001 核查）

# ---------- 下载源（国内网络优化，内部下载选源实测记录） ----------
PIP_INDEX_URL="${PIP_INDEX_URL:-https://mirrors.aliyun.com/pypi/simple/}"
# 注意: 清华源对 CNB 云构建 runner 返回 HTTP 403（2026-09-26 实测，见 .cnb.yml 头注释）；
# 真机上如需 extra-index 可保留，CI 侧只用阿里源。
PIP_EXTRA_INDEX_URL="${PIP_EXTRA_INDEX_URL:-}"
DOCKER_REGISTRY_MIRRORS="${DOCKER_REGISTRY_MIRRORS:-https://docker.m.daocloud.io}"
GITHUB_DL_MIRROR="${GITHUB_DL_MIRROR:-}"   # 可填 ghproxy 类前缀，为空则直连

# ---------- 磁盘清理（01 脚本） ----------
DISK_TARGET_PCT="${DISK_TARGET_PCT:-70}"   # 清到 <70%（工单要求）
